/*
   IMPORTANT: remove ALL foreign keys in dbo before dropping tables.
   This is required because departments <-> faculty form a circular
   relationship, and the previous version could leave one of the two
   tables behind after a failed DROP. It also handles foreign keys left
   behind by an earlier/partial execution of this script.
*/
DECLARE @sql NVARCHAR(MAX) = N'';

SELECT @sql = @sql +
    N'ALTER TABLE ' + QUOTENAME(SCHEMA_NAME(fk.schema_id)) + N'.' +
    QUOTENAME(OBJECT_NAME(fk.parent_object_id)) +
    N' DROP CONSTRAINT ' + QUOTENAME(fk.name) + N';' + CHAR(13) + CHAR(10)
FROM sys.foreign_keys AS fk
WHERE fk.schema_id = SCHEMA_ID(N'dbo')
   OR fk.referenced_object_id IN
      (
        SELECT object_id
        FROM sys.tables
        WHERE schema_id = SCHEMA_ID(N'dbo')
      );

IF @sql <> N''
    EXEC sys.sp_executesql @sql;
GO

