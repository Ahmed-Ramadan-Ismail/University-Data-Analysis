/* Capacity validation */
CREATE TRIGGER dbo.trg_enrollment_capacity
ON dbo.enrollments
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;

    IF EXISTS
    (
        SELECT 1
        FROM dbo.sections sec
        JOIN
        (
            SELECT section_id, COUNT(*) AS enrolled_count
            FROM dbo.enrollments
            WHERE status='enrolled'
            GROUP BY section_id
        ) x ON x.section_id=sec.section_id
        WHERE x.enrolled_count > sec.max_capacity
    )
    BEGIN
        ROLLBACK TRANSACTION;
        THROW 50001, 'Section has reached maximum capacity.', 1;
    END
END;
GO

/* Auto close */
CREATE TRIGGER dbo.trg_section_auto_close
ON dbo.enrollments
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE sec
    SET status='closed'
    FROM dbo.sections sec
    WHERE sec.status='open'
      AND EXISTS
      (
        SELECT 1
        FROM
        (
          SELECT section_id,COUNT(*) AS cnt
          FROM dbo.enrollments
          WHERE status='enrolled'
          GROUP BY section_id
        ) x
        WHERE x.section_id=sec.section_id
          AND x.cnt>=sec.max_capacity
      );
END;
GO

/* Enrollment audit */
CREATE TRIGGER dbo.trg_enrollment_audit
ON dbo.enrollments
AFTER INSERT, UPDATE, DELETE
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO dbo.audit_log
    (table_name,record_id,action,changed_by,old_values,new_values)
    SELECT
        'enrollments',
        COALESCE(i.enrollment_id,d.enrollment_id),
        CASE WHEN i.enrollment_id IS NULL THEN 'DELETE'
             WHEN d.enrollment_id IS NULL THEN 'INSERT'
             ELSE 'UPDATE' END,
        SUSER_SNAME(),
        CASE WHEN d.enrollment_id IS NULL THEN NULL
             ELSE (SELECT d.student_id,d.section_id,d.status,d.final_grade,d.final_score
                   FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) END,
        CASE WHEN i.enrollment_id IS NULL THEN NULL
             ELSE (SELECT i.student_id,i.section_id,i.status,i.final_grade,i.final_score
                   FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) END
    FROM inserted i
    FULL OUTER JOIN deleted d
      ON i.enrollment_id=d.enrollment_id;
END;
GO

/* Student audit */
CREATE TRIGGER dbo.trg_student_audit
ON dbo.students
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO dbo.audit_log
    (table_name,record_id,action,changed_by,old_values,new_values)
    SELECT
        'students',
        i.student_id,
        'UPDATE',
        SUSER_SNAME(),
        (SELECT d.gpa,d.status FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),
        (SELECT i.gpa,i.status FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)
    FROM inserted i
    JOIN deleted d ON d.student_id=i.student_id
    WHERE ISNULL(i.gpa,-1)<>ISNULL(d.gpa,-1)
       OR ISNULL(i.status,'')<>ISNULL(d.status,'');
END;
GO

