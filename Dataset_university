/* ============================================================
   1. semesters
   ============================================================ */
CREATE TABLE dbo.semesters (
    semester_id     TINYINT IDENTITY(1,1) NOT NULL,
    term            VARCHAR(20) NOT NULL,
    academic_year   SMALLINT NOT NULL,
    name            VARCHAR(20) NOT NULL,
    start_date      DATE NOT NULL,
    end_date        DATE NOT NULL,
    enroll_deadline DATE NOT NULL,
    is_active       BIT NOT NULL CONSTRAINT DF_semesters_active DEFAULT 0,
    CONSTRAINT PK_semesters PRIMARY KEY (semester_id),
    CONSTRAINT UQ_semester UNIQUE (term, academic_year),
    CONSTRAINT CK_semester_term CHECK (term IN ('Fall','Spring','Summer'))
);
GO

/* ============================================================
   2. rooms
   ============================================================ */
CREATE TABLE dbo.rooms (
    room_id       SMALLINT IDENTITY(1,1) NOT NULL,
    building      VARCHAR(60) NOT NULL,
    room_number   VARCHAR(10) NOT NULL,
    capacity      SMALLINT NOT NULL,
    room_type     VARCHAR(20) NOT NULL CONSTRAINT DF_rooms_type DEFAULT 'lecture',
    has_projector BIT NOT NULL CONSTRAINT DF_rooms_projector DEFAULT 1,
    has_video     BIT NOT NULL CONSTRAINT DF_rooms_video DEFAULT 0,
    CONSTRAINT PK_rooms PRIMARY KEY (room_id),
    CONSTRAINT UQ_room UNIQUE (building, room_number),
    CONSTRAINT CK_room_type CHECK (room_type IN ('lecture','seminar','lab','computer_lab','online')),
    CONSTRAINT CK_room_capacity CHECK (capacity > 0)
);
GO

/* ============================================================
   3. scholarships
   ============================================================ */
CREATE TABLE dbo.scholarships (
    scholarship_id SMALLINT IDENTITY(1,1) NOT NULL,
    name           VARCHAR(150) NOT NULL,
    amount         DECIMAL(10,2) NOT NULL,
    frequency      VARCHAR(20) NOT NULL CONSTRAINT DF_scholarship_frequency DEFAULT 'annual',
    eligibility    NVARCHAR(MAX) NULL,
    is_active      BIT NOT NULL CONSTRAINT DF_scholarship_active DEFAULT 1,
    CONSTRAINT PK_scholarships PRIMARY KEY (scholarship_id),
    CONSTRAINT CK_scholarship_frequency CHECK (frequency IN ('one-time','annual','per-semester')),
    CONSTRAINT CK_scholarship_amount CHECK (amount >= 0),
    CONSTRAINT CK_scholarship_json CHECK (eligibility IS NULL OR ISJSON(eligibility) = 1)
);
GO

/* ============================================================
   4. departments
   ============================================================ */
CREATE TABLE dbo.departments (
    department_id   TINYINT NOT NULL,
    parent_id       TINYINT NULL,
    code            VARCHAR(10) NOT NULL,
    name            VARCHAR(100) NOT NULL,
    level           TINYINT NOT NULL CONSTRAINT DF_department_level DEFAULT 1,
    head_faculty_id SMALLINT NULL,
    established     SMALLINT NULL,
    CONSTRAINT PK_departments PRIMARY KEY (department_id),
    CONSTRAINT UQ_dept_code UNIQUE (code),
    CONSTRAINT CK_department_level CHECK (level IN (1,2,3))
);
GO

ALTER TABLE dbo.departments
ADD CONSTRAINT FK_dept_parent
FOREIGN KEY (parent_id) REFERENCES dbo.departments(department_id);
GO

/* ============================================================
   5. faculty
   ============================================================ */
CREATE TABLE dbo.faculty (
    faculty_id    SMALLINT IDENTITY(1,1) NOT NULL,
    department_id TINYINT NOT NULL,
    first_name    VARCHAR(50) NOT NULL,
    last_name     VARCHAR(50) NOT NULL,
    email         VARCHAR(100) NOT NULL,
    phone         VARCHAR(20) NULL,
    rank          VARCHAR(30) NOT NULL,
    hire_date     DATE NOT NULL,
    office        VARCHAR(50) NULL,
    office_hours  NVARCHAR(MAX) NULL,
    bio           NVARCHAR(MAX) NULL,
    is_active     BIT NOT NULL CONSTRAINT DF_faculty_active DEFAULT 1,
    CONSTRAINT PK_faculty PRIMARY KEY (faculty_id),
    CONSTRAINT UQ_faculty_email UNIQUE (email),
    CONSTRAINT CK_faculty_rank CHECK
       (rank IN ('Instructor','Assistant Professor','Associate Professor','Professor','Emeritus')),
    CONSTRAINT CK_faculty_json CHECK (office_hours IS NULL OR ISJSON(office_hours) = 1),
    CONSTRAINT FK_faculty_dept FOREIGN KEY (department_id)
       REFERENCES dbo.departments(department_id)
);
GO

ALTER TABLE dbo.departments
ADD CONSTRAINT FK_dept_head
FOREIGN KEY (head_faculty_id) REFERENCES dbo.faculty(faculty_id);
GO

/* ============================================================
   6. students
   ============================================================ */
CREATE TABLE dbo.students (
    student_id       INT IDENTITY(1,1) NOT NULL,
    department_id    TINYINT NOT NULL,
    student_number   CHAR(10) NOT NULL,
    first_name       VARCHAR(50) NOT NULL,
    last_name        VARCHAR(50) NOT NULL,
    email            VARCHAR(100) NOT NULL,
    date_of_birth    DATE NOT NULL,
    gender           VARCHAR(25) NULL,
    enrollment_date  DATE NOT NULL,
    expected_grad    SMALLINT NULL,
    status           VARCHAR(20) NOT NULL CONSTRAINT DF_students_status DEFAULT 'active',
    gpa              DECIMAL(4,3) NULL,
    contacts         NVARCHAR(MAX) NULL,
    CONSTRAINT PK_students PRIMARY KEY (student_id),
    CONSTRAINT UQ_student_number UNIQUE (student_number),
    CONSTRAINT UQ_student_email UNIQUE (email),
    CONSTRAINT CK_student_gender CHECK
       (gender IS NULL OR gender IN ('M','F','NB','Other','Prefer not to say')),
    CONSTRAINT CK_student_status CHECK
       (status IN ('active','inactive','graduated','suspended','withdrawn')),
    CONSTRAINT CK_student_gpa CHECK (gpa IS NULL OR (gpa >= 0 AND gpa <= 4)),
    CONSTRAINT CK_student_json CHECK (contacts IS NULL OR ISJSON(contacts) = 1),
    CONSTRAINT FK_student_dept FOREIGN KEY (department_id)
       REFERENCES dbo.departments(department_id)
);
GO

/* ============================================================
   7. courses
   embedding is NVARCHAR(MAX) for broad SQL Server compatibility.
   ============================================================ */
CREATE TABLE dbo.courses (
    course_id     SMALLINT IDENTITY(1,1) NOT NULL,
    department_id TINYINT NOT NULL,
    code          CHAR(10) NOT NULL,
    title         VARCHAR(150) NOT NULL,
    credits       TINYINT NOT NULL CONSTRAINT DF_courses_credits DEFAULT 3,
    level         VARCHAR(20) NOT NULL CONSTRAINT DF_courses_level DEFAULT 'undergraduate',
    description   NVARCHAR(MAX) NULL,
    is_active     BIT NOT NULL CONSTRAINT DF_courses_active DEFAULT 1,
    embedding     NVARCHAR(MAX) NULL,
    CONSTRAINT PK_courses PRIMARY KEY (course_id),
    CONSTRAINT UQ_course_code UNIQUE (code),
    CONSTRAINT CK_course_level CHECK (level IN ('undergraduate','graduate','doctoral')),
    CONSTRAINT CK_course_credits CHECK (credits BETWEEN 1 AND 10),
    CONSTRAINT FK_course_dept FOREIGN KEY (department_id)
       REFERENCES dbo.departments(department_id)
);
GO

/* ============================================================
   8. course_prerequisites
   ============================================================ */
CREATE TABLE dbo.course_prerequisites (
    course_id       SMALLINT NOT NULL,
    prerequisite_id SMALLINT NOT NULL,
    is_mandatory    BIT NOT NULL CONSTRAINT DF_prereq_mandatory DEFAULT 1,
    CONSTRAINT PK_course_prerequisites PRIMARY KEY (course_id, prerequisite_id),
    CONSTRAINT CK_no_self_prereq CHECK (course_id <> prerequisite_id),
    CONSTRAINT FK_prereq_course FOREIGN KEY (course_id)
       REFERENCES dbo.courses(course_id),
    CONSTRAINT FK_prereq_prereq FOREIGN KEY (prerequisite_id)
       REFERENCES dbo.courses(course_id)
);
GO

/* ============================================================
   9. sections
   ============================================================ */
CREATE TABLE dbo.sections (
    section_id     INT IDENTITY(1,1) NOT NULL,
    course_id      SMALLINT NOT NULL,
    semester_id    TINYINT NOT NULL,
    faculty_id     SMALLINT NOT NULL,
    room_id        SMALLINT NULL,
    section_number TINYINT NOT NULL CONSTRAINT DF_section_number DEFAULT 1,
    delivery       VARCHAR(20) NOT NULL CONSTRAINT DF_section_delivery DEFAULT 'in-person',
    max_capacity   SMALLINT NOT NULL CONSTRAINT DF_section_capacity DEFAULT 30,
    status         VARCHAR(20) NOT NULL CONSTRAINT DF_section_status DEFAULT 'open',
    schedule       NVARCHAR(MAX) NULL,
    CONSTRAINT PK_sections PRIMARY KEY (section_id),
    CONSTRAINT UQ_section UNIQUE (course_id, semester_id, section_number),
    CONSTRAINT CK_section_delivery CHECK (delivery IN ('in-person','online','hybrid')),
    CONSTRAINT CK_section_status CHECK (status IN ('open','closed','cancelled','completed')),
    CONSTRAINT CK_section_capacity CHECK (max_capacity > 0),
    CONSTRAINT CK_section_json CHECK (schedule IS NULL OR ISJSON(schedule) = 1),
    CONSTRAINT FK_section_course FOREIGN KEY (course_id) REFERENCES dbo.courses(course_id),
    CONSTRAINT FK_section_semester FOREIGN KEY (semester_id) REFERENCES dbo.semesters(semester_id),
    CONSTRAINT FK_section_faculty FOREIGN KEY (faculty_id) REFERENCES dbo.faculty(faculty_id),
    CONSTRAINT FK_section_room FOREIGN KEY (room_id) REFERENCES dbo.rooms(room_id)
);
GO

/* ============================================================
   10. enrollments
   ============================================================ */
CREATE TABLE dbo.enrollments (
    enrollment_id INT IDENTITY(1,1) NOT NULL,
    student_id    INT NOT NULL,
    section_id    INT NOT NULL,
    enrolled_at   DATETIME2 NOT NULL CONSTRAINT DF_enrollment_date DEFAULT SYSDATETIME(),
    status        VARCHAR(20) NOT NULL CONSTRAINT DF_enrollment_status DEFAULT 'enrolled',
    final_grade   CHAR(2) NULL,
    final_score   DECIMAL(5,2) NULL,
    CONSTRAINT PK_enrollments PRIMARY KEY (enrollment_id),
    CONSTRAINT UQ_enrollment UNIQUE (student_id, section_id),
    CONSTRAINT CK_enrollment_status CHECK (status IN ('enrolled','dropped','completed','failed','incomplete')),
    CONSTRAINT CK_final_score CHECK (final_score IS NULL OR (final_score >= 0 AND final_score <= 100)),
    CONSTRAINT FK_enroll_student FOREIGN KEY (student_id) REFERENCES dbo.students(student_id),
    CONSTRAINT FK_enroll_section FOREIGN KEY (section_id) REFERENCES dbo.sections(section_id)
);
GO

/* ============================================================
   11. student_scholarships
   ============================================================ */
CREATE TABLE dbo.student_scholarships (
    award_id       INT IDENTITY(1,1) NOT NULL,
    student_id     INT NOT NULL,
    scholarship_id SMALLINT NOT NULL,
    awarded_date   DATE NOT NULL,
    expires_date   DATE NULL,
    amount_awarded DECIMAL(10,2) NOT NULL,
    notes          NVARCHAR(MAX) NULL,
    CONSTRAINT PK_student_scholarships PRIMARY KEY (award_id),
    CONSTRAINT CK_award_amount CHECK (amount_awarded >= 0),
    CONSTRAINT FK_award_student FOREIGN KEY (student_id) REFERENCES dbo.students(student_id),
    CONSTRAINT FK_award_scholarship FOREIGN KEY (scholarship_id) REFERENCES dbo.scholarships(scholarship_id)
);
GO

/* ============================================================
   12. research_projects
   ============================================================ */
CREATE TABLE dbo.research_projects (
    project_id      SMALLINT IDENTITY(1,1) NOT NULL,
    department_id   TINYINT NOT NULL,
    lead_faculty_id SMALLINT NOT NULL,
    title           VARCHAR(200) NOT NULL,
    abstract        NVARCHAR(MAX) NULL,
    start_date      DATE NOT NULL,
    end_date        DATE NULL,
    status          VARCHAR(20) NOT NULL CONSTRAINT DF_project_status DEFAULT 'proposed',
    funding         NVARCHAR(MAX) NULL,
    CONSTRAINT PK_research_projects PRIMARY KEY (project_id),
    CONSTRAINT CK_project_status CHECK (status IN ('proposed','active','completed','cancelled')),
    CONSTRAINT CK_project_json CHECK (funding IS NULL OR ISJSON(funding) = 1),
    CONSTRAINT FK_project_dept FOREIGN KEY (department_id) REFERENCES dbo.departments(department_id),
    CONSTRAINT FK_project_lead FOREIGN KEY (lead_faculty_id) REFERENCES dbo.faculty(faculty_id)
);
GO

/* ============================================================
   13. publications
   ============================================================ */
CREATE TABLE dbo.publications (
    publication_id INT IDENTITY(1,1) NOT NULL,
    project_id     SMALLINT NULL,
    title          VARCHAR(300) NOT NULL,
    abstract       NVARCHAR(MAX) NULL,
    pub_year       SMALLINT NOT NULL,
    venue          VARCHAR(200) NULL,
    doi            VARCHAR(100) NULL,
    keywords       VARCHAR(500) NOT NULL CONSTRAINT DF_publication_keywords DEFAULT '',
    citation_count INT NOT NULL CONSTRAINT DF_publication_citations DEFAULT 0,
    CONSTRAINT PK_publications PRIMARY KEY (publication_id),
    CONSTRAINT CK_publication_year CHECK (pub_year BETWEEN 1900 AND 2100),
    CONSTRAINT CK_publication_citations CHECK (citation_count >= 0),
    CONSTRAINT FK_pub_project FOREIGN KEY (project_id) REFERENCES dbo.research_projects(project_id)
);
GO

CREATE UNIQUE INDEX UX_publications_doi
ON dbo.publications(doi)
WHERE doi IS NOT NULL;
GO

/* ============================================================
   14. project_members
   ============================================================ */
CREATE TABLE dbo.project_members (
    member_id   INT IDENTITY(1,1) NOT NULL,
    project_id  SMALLINT NOT NULL,
    faculty_id  SMALLINT NULL,
    student_id  INT NULL,
    role        VARCHAR(30) NOT NULL,
    joined_date DATE NOT NULL,
    left_date   DATE NULL,
    CONSTRAINT PK_project_members PRIMARY KEY (member_id),
    CONSTRAINT CK_member_identity CHECK (faculty_id IS NOT NULL OR student_id IS NOT NULL),
    CONSTRAINT CK_member_role CHECK
       (role IN ('Principal Investigator','Co-Investigator','Research Assistant','Graduate Student','Undergraduate Student')),
    CONSTRAINT FK_member_project FOREIGN KEY (project_id) REFERENCES dbo.research_projects(project_id),
    CONSTRAINT FK_member_faculty FOREIGN KEY (faculty_id) REFERENCES dbo.faculty(faculty_id),
    CONSTRAINT FK_member_student FOREIGN KEY (student_id) REFERENCES dbo.students(student_id)
);
GO

/* ============================================================
   15. grade_events
   ============================================================ */
CREATE TABLE dbo.grade_events (
    event_id      BIGINT IDENTITY(1,1) NOT NULL,
    enrollment_id INT NOT NULL,
    item_name     VARCHAR(100) NOT NULL,
    item_type     VARCHAR(20) NOT NULL,
    score         DECIMAL(6,2) NOT NULL,
    max_score     DECIMAL(6,2) NOT NULL CONSTRAINT DF_grade_max DEFAULT 100,
    weight        DECIMAL(5,4) NOT NULL,
    graded_at     DATETIME2 NOT NULL,
    grader_id     SMALLINT NULL,
    feedback      NVARCHAR(MAX) NULL,
    CONSTRAINT PK_grade_events PRIMARY KEY (event_id),
    CONSTRAINT CK_grade_item_type CHECK
       (item_type IN ('assignment','quiz','midterm','final','project','participation','lab')),
    CONSTRAINT CK_grade_score CHECK (score >= 0 AND max_score > 0 AND score <= max_score),
    CONSTRAINT CK_grade_weight CHECK (weight >= 0 AND weight <= 1),
    CONSTRAINT FK_ge_enrollment FOREIGN KEY (enrollment_id) REFERENCES dbo.enrollments(enrollment_id),
    CONSTRAINT FK_ge_grader FOREIGN KEY (grader_id) REFERENCES dbo.faculty(faculty_id)
);
GO

/* ============================================================
   16. audit_log
   ============================================================ */
CREATE TABLE dbo.audit_log (
    log_id      BIGINT IDENTITY(1,1) NOT NULL,
    table_name  VARCHAR(64) NOT NULL,
    record_id   BIGINT NOT NULL,
    action      VARCHAR(10) NOT NULL,
    changed_at  DATETIME2 NOT NULL CONSTRAINT DF_audit_date DEFAULT SYSDATETIME(),
    changed_by  VARCHAR(100) NULL,
    old_values  NVARCHAR(MAX) NULL,
    new_values  NVARCHAR(MAX) NULL,
    CONSTRAINT PK_audit_log PRIMARY KEY (log_id),
    CONSTRAINT CK_audit_action CHECK (action IN ('INSERT','UPDATE','DELETE')),
    CONSTRAINT CK_audit_old_json CHECK (old_values IS NULL OR ISJSON(old_values) = 1),
    CONSTRAINT CK_audit_new_json CHECK (new_values IS NULL OR ISJSON(new_values) = 1)
);
GO

CREATE INDEX IX_audit_table_record ON dbo.audit_log(table_name, record_id);
CREATE INDEX IX_audit_changed_at ON dbo.audit_log(changed_at);
CREATE INDEX IX_audit_action ON dbo.audit_log(action);
