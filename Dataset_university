/* ============================================================
   Recalculate final scores for enrollments with grade events
   ============================================================ */
;WITH G AS
(
    SELECT
        enrollment_id,
        ROUND(SUM((score/max_score)*weight*100.0),2) AS final_score
    FROM dbo.grade_events
    GROUP BY enrollment_id
)
UPDATE e
SET
    e.final_score = G.final_score,
    e.final_grade =
       CASE
         WHEN G.final_score >= 93 THEN 'A'
         WHEN G.final_score >= 90 THEN 'A-'
         WHEN G.final_score >= 87 THEN 'B+'
         WHEN G.final_score >= 83 THEN 'B'
         WHEN G.final_score >= 80 THEN 'B-'
         WHEN G.final_score >= 77 THEN 'C+'
         WHEN G.final_score >= 73 THEN 'C'
         WHEN G.final_score >= 70 THEN 'C-'
         WHEN G.final_score >= 60 THEN 'D'
         ELSE 'F'
       END
FROM dbo.enrollments e
JOIN G ON G.enrollment_id=e.enrollment_id
WHERE e.status='completed';
GO

/* ============================================================
   Calculate student GPA
   ============================================================ */
;WITH G AS
(
    SELECT
       e.student_id,
       CAST(
       SUM(
          CASE e.final_grade
            WHEN 'A' THEN 4.0
            WHEN 'A-' THEN 3.7
            WHEN 'B+' THEN 3.3
            WHEN 'B' THEN 3.0
            WHEN 'B-' THEN 2.7
            WHEN 'C+' THEN 2.3
            WHEN 'C' THEN 2.0
            WHEN 'C-' THEN 1.7
            WHEN 'D' THEN 1.0
            ELSE 0.0
          END*c.credits
       ) / NULLIF(SUM(c.credits),0) AS DECIMAL(4,3)) AS gpa
    FROM dbo.enrollments e
    JOIN dbo.sections sec ON sec.section_id=e.section_id
    JOIN dbo.courses c ON c.course_id=sec.course_id
    WHERE e.status='completed'
    GROUP BY e.student_id
)
UPDATE s
SET s.gpa=G.gpa
FROM dbo.students s
JOIN G ON G.student_id=s.student_id;
GO

