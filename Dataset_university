/* ============================================================
   VIEWS
   ============================================================ */

CREATE VIEW dbo.v_student_gpa AS
SELECT
    s.student_id,
    s.student_number,
    CONCAT(s.first_name,' ',s.last_name) AS student_name,
    sem.semester_id,
    sem.name AS semester,
    COUNT(e.enrollment_id) AS courses_taken,
    ROUND(AVG(e.final_score),2) AS avg_score,
    ROUND(
      SUM(
        CASE e.final_grade
          WHEN 'A' THEN 4.0*c.credits
          WHEN 'A-' THEN 3.7*c.credits
          WHEN 'B+' THEN 3.3*c.credits
          WHEN 'B' THEN 3.0*c.credits
          WHEN 'B-' THEN 2.7*c.credits
          WHEN 'C+' THEN 2.3*c.credits
          WHEN 'C' THEN 2.0*c.credits
          WHEN 'C-' THEN 1.7*c.credits
          WHEN 'D' THEN 1.0*c.credits
          ELSE 0
        END
      ) / NULLIF(SUM(c.credits),0),3
    ) AS semester_gpa
FROM dbo.students s
JOIN dbo.enrollments e ON e.student_id=s.student_id AND e.status='completed'
JOIN dbo.sections sec ON sec.section_id=e.section_id
JOIN dbo.semesters sem ON sem.semester_id=sec.semester_id
JOIN dbo.courses c ON c.course_id=sec.course_id
GROUP BY s.student_id,s.student_number,s.first_name,s.last_name,sem.semester_id,sem.name;
GO

CREATE VIEW dbo.v_section_roster AS
SELECT
    sec.section_id,
    c.code AS course_code,
    c.title AS course_title,
    sem.name AS semester,
    CONCAT(f.first_name,' ',f.last_name) AS instructor,
    s.student_number,
    CONCAT(s.first_name,' ',s.last_name) AS student_name,
    s.email AS student_email,
    e.enrollment_id,
    e.status AS enrollment_status,
    e.final_grade
FROM dbo.sections sec
JOIN dbo.courses c ON c.course_id=sec.course_id
JOIN dbo.semesters sem ON sem.semester_id=sec.semester_id
JOIN dbo.faculty f ON f.faculty_id=sec.faculty_id
JOIN dbo.enrollments e ON e.section_id=sec.section_id
JOIN dbo.students s ON s.student_id=e.student_id;
GO

CREATE VIEW dbo.v_course_pass_rate AS
SELECT
    c.course_id,
    c.code,
    c.title,
    d.name AS department,
    COUNT(e.enrollment_id) AS total_enrollments,
    SUM(CASE WHEN e.status='completed' THEN 1 ELSE 0 END) AS completed,
    SUM(CASE WHEN e.status='failed' THEN 1 ELSE 0 END) AS failed,
    SUM(CASE WHEN e.status='dropped' THEN 1 ELSE 0 END) AS dropped,
    ROUND(
      100.0*SUM(CASE WHEN e.status='completed' THEN 1 ELSE 0 END)
      / NULLIF(COUNT(e.enrollment_id),0),1
    ) AS pass_rate_pct,
    ROUND(AVG(e.final_score),2) AS avg_final_score
FROM dbo.courses c
JOIN dbo.departments d ON d.department_id=c.department_id
LEFT JOIN dbo.sections sec ON sec.course_id=c.course_id
LEFT JOIN dbo.enrollments e ON e.section_id=sec.section_id
GROUP BY c.course_id,c.code,c.title,d.name;
GO

CREATE VIEW dbo.v_faculty_workload AS
SELECT
    f.faculty_id,
    CONCAT(f.first_name,' ',f.last_name) AS faculty_name,
    f.rank,
    d.name AS department,
    COUNT(DISTINCT sec.section_id) AS sections_taught,
    SUM(sec.max_capacity) AS total_capacity,
    COUNT(e.enrollment_id) AS total_students_enrolled,
    ROUND(
      100.0*COUNT(e.enrollment_id)
      / NULLIF(SUM(sec.max_capacity),0),1
    ) AS avg_fill_rate_pct
FROM dbo.faculty f
JOIN dbo.departments d ON d.department_id=f.department_id
LEFT JOIN dbo.sections sec ON sec.faculty_id=f.faculty_id
LEFT JOIN dbo.enrollments e ON e.section_id=sec.section_id
AND e.status IN ('enrolled','completed','failed')
GROUP BY f.faculty_id,f.first_name,f.last_name,f.rank,d.name;
GO

CREATE VIEW dbo.v_top_scholars AS
SELECT
