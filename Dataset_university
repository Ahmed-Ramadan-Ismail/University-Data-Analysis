CREATE PROCEDURE dbo.sp_enroll_student
    @p_student_id INT,
    @p_section_id INT,
    @p_enrollment_id INT OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @status VARCHAR(20), @course_id SMALLINT, @missing VARCHAR(150);

    SELECT @status=status,@course_id=course_id
    FROM dbo.sections
    WHERE section_id=@p_section_id;

    IF @status IS NULL
        THROW 50010,'Section not found',1;

    IF @status<>'open'
        THROW 50011,'Section is not open for enrollment',1;

    IF EXISTS
    (
      SELECT 1 FROM dbo.enrollments
      WHERE student_id=@p_student_id
        AND section_id=@p_section_id
        AND status<>'dropped'
    )
        THROW 50012,'Student is already enrolled in this section',1;

    SELECT TOP (1) @missing=c.title
    FROM dbo.course_prerequisites cp
    JOIN dbo.courses c ON c.course_id=cp.prerequisite_id
    WHERE cp.course_id=@course_id
      AND cp.is_mandatory=1
      AND NOT EXISTS
      (
        SELECT 1
        FROM dbo.enrollments e
        JOIN dbo.sections s ON s.section_id=e.section_id
        WHERE e.student_id=@p_student_id
          AND s.course_id=cp.prerequisite_id
          AND e.status='completed'
      );

    IF @missing IS NOT NULL
    BEGIN
        DECLARE @msg NVARCHAR(2048)=CONCAT('Missing prerequisite: ',@missing);
        THROW 50013,@msg,1;
    END

    INSERT INTO dbo.enrollments(student_id,section_id,status)
    VALUES(@p_student_id,@p_section_id,'enrolled');

    SET @p_enrollment_id=CONVERT(INT,SCOPE_IDENTITY());
END;
GO

CREATE PROCEDURE dbo.sp_drop_enrollment
    @p_enrollment_id INT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @section_id INT,@current_status VARCHAR(20);

    SELECT @section_id=section_id,@current_status=status
    FROM dbo.enrollments
    WHERE enrollment_id=@p_enrollment_id;

    IF @current_status IS NULL
        THROW 50020,'Enrollment not found',1;

    IF @current_status<>'enrolled'
        THROW 50021,'Only active enrollments can be dropped',1;

    UPDATE dbo.enrollments
    SET status='dropped'
    WHERE enrollment_id=@p_enrollment_id;

    UPDATE sec
    SET status='open'
    FROM dbo.sections sec
    WHERE sec.section_id=@section_id
      AND sec.status='closed'
      AND
      (
        SELECT COUNT(*)
        FROM dbo.enrollments e
        WHERE e.section_id=@section_id
          AND e.status='enrolled'
      )<sec.max_capacity;
END;
GO

CREATE PROCEDURE dbo.sp_submit_grade
    @p_enrollment_id INT,
    @p_item_name VARCHAR(100),
    @p_item_type VARCHAR(20),
    @p_score DECIMAL(6,2),
    @p_max_score DECIMAL(6,2),
    @p_weight DECIMAL(5,4),
    @p_grader_id SMALLINT
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO dbo.grade_events
    (enrollment_id,item_name,item_type,score,max_score,weight,graded_at,grader_id)
    VALUES
    (@p_enrollment_id,@p_item_name,@p_item_type,@p_score,@p_max_score,@p_weight,SYSDATETIME(),@p_grader_id);

    DECLARE @weighted DECIMAL(8,4);

    SELECT @weighted=SUM((score/max_score)*weight*100.0)
    FROM dbo.grade_events
    WHERE enrollment_id=@p_enrollment_id;

    UPDATE dbo.enrollments
    SET final_score=ROUND(@weighted,2),
        final_grade=CASE
          WHEN @weighted>=93 THEN 'A'
          WHEN @weighted>=90 THEN 'A-'
          WHEN @weighted>=87 THEN 'B+'
          WHEN @weighted>=83 THEN 'B'
          WHEN @weighted>=80 THEN 'B-'
          WHEN @weighted>=77 THEN 'C+'
          WHEN @weighted>=73 THEN 'C'
          WHEN @weighted>=70 THEN 'C-'
          WHEN @weighted>=60 THEN 'D'
          ELSE 'F' END,
        status=CASE
          WHEN @p_item_type='final' AND @weighted>=60 THEN 'completed'
          WHEN @p_item_type='final' AND @weighted<60 THEN 'failed'
          ELSE status END
    WHERE enrollment_id=@p_enrollment_id;
END;
GO

CREATE PROCEDURE dbo.sp_calculate_gpa
    @p_student_id INT,
    @p_gpa DECIMAL(4,3) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT @p_gpa=
      ROUND(
        SUM(
          CASE e.final_grade
            WHEN 'A' THEN 4.0
            WHEN 'A-' THEN 3.7
            WHEN 'B+' THEN 3.3
            WHEN 'B' THEN 3.0
            WHEN 'B-' THEN 2.7
            WHEN 'C+' THEN 2.3
            WHEN 'C' THEN 2.0
            WHEN 'C-' THEN 1.7
            WHEN 'D' THEN 1.0
            ELSE 0 END*c.credits
        )/NULLIF(SUM(c.credits),0),3)
    FROM dbo.enrollments e
    JOIN dbo.sections sec ON sec.section_id=e.section_id
    JOIN dbo.courses c ON c.course_id=sec.course_id
    WHERE e.student_id=@p_student_id
      AND e.status='completed';

    UPDATE dbo.students
    SET gpa=@p_gpa
    WHERE student_id=@p_student_id;
END;
GO

CREATE PROCEDURE dbo.sp_get_prerequisite_chain
    @p_course_id SMALLINT
AS
BEGIN
    SET NOCOUNT ON;

    WITH prereq_tree AS
    (
      SELECT
        cp.course_id,
        cp.prerequisite_id,
        c.code AS course_code,
        p.code AS prereq_code,
        p.title AS prereq_title,
        cp.is_mandatory,
        1 AS depth
      FROM dbo.course_prerequisites cp
      JOIN dbo.courses c ON c.course_id=cp.course_id
      JOIN dbo.courses p ON p.course_id=cp.prerequisite_id
      WHERE cp.course_id=@p_course_id

      UNION ALL

      SELECT
        cp2.course_id,
        cp2.prerequisite_id,
        c2.code,
        p2.code,
        p2.title,
        cp2.is_mandatory,
        pt.depth+1
      FROM dbo.course_prerequisites cp2
      JOIN prereq_tree pt ON pt.prerequisite_id=cp2.course_id
      JOIN dbo.courses c2 ON c2.course_id=cp2.course_id
      JOIN dbo.courses p2 ON p2.course_id=cp2.prerequisite_id
      WHERE pt.depth<10
    )
    SELECT DISTINCT depth,prereq_code,prereq_title,is_mandatory
    FROM prereq_tree
    ORDER BY depth,prereq_code
    OPTION (MAXRECURSION 10);
END;
GO

/* SQL Server-compatible replacement for MariaDB vector search.
   It searches course title/description using a keyword. */
CREATE PROCEDURE dbo.sp_search_courses_semantic
    @p_search_term NVARCHAR(200),
    @p_limit INT = 10
AS
BEGIN
    SET NOCOUNT ON;

    SELECT TOP (@p_limit)
        c.course_id,
        c.code,
        c.title,
        c.credits,
        d.name AS department,
        CASE
          WHEN c.title LIKE N'%'+@p_search_term+N'%' THEN 0
          ELSE 1
        END AS distance
    FROM dbo.courses c
    JOIN dbo.departments d ON d.department_id=c.department_id
    WHERE c.is_active=1
      AND
      (
        c.title LIKE N'%'+@p_search_term+N'%'
        OR c.description LIKE N'%'+@p_search_term+N'%'
      )
    ORDER BY distance,c.code;
END;
GO

