SELECT
S.student_id,
S.first_name AS student_first_name,
S.last_name AS student_last_name,
S.gpa,
S.status AS student_status,

D.department_id,
D.name AS department_name,

E.enrollment_id,
E.enrolled_at,
E.status AS enrollment_status,
E.final_grade,
E.final_score,

SE.section_id,
SE.semester_id,
SE.faculty_id,
SE.room_id,

C.course_id,
C.code AS course_code,
C.title AS course_title,
C.credits,
C.level,

F.first_name AS faculty_first_name,
F.last_name AS faculty_last_name,

SC.scholarship_id,
SC.name AS scholarship_name,
SC.amount AS scholarship_amount

FROM dbo.students AS S

LEFT JOIN dbo.departments AS D
ON S.department_id = D.department_id

LEFT JOIN dbo.enrollments AS E
ON S.student_id = E.student_id

LEFT JOIN dbo.sections AS SE
ON E.section_id = SE.section_id

LEFT JOIN dbo.courses AS C
ON SE.course_id = C.course_id

LEFT JOIN dbo.faculty AS F
ON SE.faculty_id = F.faculty_id

LEFT JOIN dbo.student_scholarships AS SS
ON S.student_id = SS.student_id

LEFT JOIN dbo.scholarships AS SC
ON SS.scholarship_id = SC.scholarship_id;


Select *
from U_S